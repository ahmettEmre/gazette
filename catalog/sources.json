{
  "_doc": "Curated source packs. /gazette-setup copies the packs that match your interests into config/sources.json (./gazette sources init --packs a,b). Add your own sources there, not here. Types: docs/sources.md",
  "defaults": {
    "max": 8,
    "summary_chars": 260,
    "first_window_hours": 72,
    "max_window_days": 8
